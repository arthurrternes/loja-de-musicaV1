<h1>Editar Fornecedor</h1>
<div>
<a href="/fornecedor/lst">Ver Lista de Fornecedores</a>
</div>
<div>
    <form  method="post">
        <label>Nome:</label>
        <input type="text" name="nome" 
        value="<%=fornecedor.nome%>" required><br>
