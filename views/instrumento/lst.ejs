<%-include('../cabecalho.ejs')%>
    <h1>Instrumentos</h1>
    <div>
        <form action="/instrumento/lst" method="post">
        <input type="text" name="filtro"
         id="" placeholder="digite o nome">
         <button type="submit">Pesquisar</button>
    </form>
    </div>
    <a href="/instrumento/add">+ Instrumento</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>Categoria</td>
            <td>Preço</td>
            <td>Nível</td>
            <td>Foto</td>
            <td>Ações</td>
        </tr>
      
        <%for (const {id, nome, categoria, preco, nivel, foto} of Instrumentos) {%>
        <tr>
            <td><%=nome%></td>
            <td><%=categoria ? categoria.nome : ''%></td>
            <td><%=preco%></td>
            <td><%=nivel%></td>
            <td><% if(foto){ %><img src="<%=foto%>" width="80" height="80"><% } %></td>
            <td><a href="/instrumento/edt/<%=id%>">Editar</a>
            <a href="/instrumento/del/<%=id%>">Excluir</a></td>
        </tr>
        <%}%>
    </table>
 <%-include('../rodape.ejs')%>