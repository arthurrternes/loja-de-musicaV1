<!doctype html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Loja Harmonia — instrumentos musicais para todos os ritmos.">
    <title>Harmonia | Instrumentos Musicais</title>
    <link rel="stylesheet" href="/css/style-site.css">
</head>

<body>
    <a class="skip" href="#conteudo">Pular para o conteúdo</a>
    <div class="announcement">Frete grátis acima de R$ 499 para todo o Brasil</div>
    <header class="header">
        <div class="header-main container">
            <a class="logo" href="/site" aria-label="Harmonia - início"><span
                    class="logo-mark"><i></i><i></i><i></i><i></i></span><span>harmonia<small>instrumentos
                        musicais</small></span></a>
            <form class="search" action="/site/catalogo" method="post"><label hidden for="busca">Buscar produtos</label><input
                    id="busca" name="q" placeholder="O que você quer tocar hoje?"><button
                    aria-label="Pesquisar">⌕</button></form>
            <div class="header-actions"><a class="header-action"
                    href="/site/conta"><b>♙</b><span><small>Bem-vindo</small>Entrar ou cadastrar</span></a><a
                    class="header-action" href="/site/carrinho"><b>□</b><span><small>Seu carrinho</small>1 item</span></a>
            </div>
        </div>
        <nav class="nav" aria-label="Navegação principal">
            <div class="nav-inner container"><a href="/site/catalogo">Todos os produtos</a>
                <% categorias.forEach(function(categoria){ %>
                <a href="/site/catalogo/<%=categoria.id%>"><%=categoria.nome%></a>
                <% }) %>
                <a href="/site/pedidos">Meus pedidos</a></div>
        </nav>
    </header>