<%-include('cabecalho.ejs')%>
        <main class="page container">
            <div class="breadcrumbs"><a href="/site">Início</a><span>›</span>
                <% if(instrumento.categoria){ %><a href="/site/catalogo/<%=instrumento.categoria.id%>"><%=instrumento.categoria.nome%></a><span>›</span><% } %>
                <span><%=instrumento.nome%></span></div>
            <section class="product-detail">
                <div class="detail-image"><% if(instrumento.foto){ %><img src="<%=instrumento.foto%>" alt="<%=instrumento.nome%>"><% } %></div>
                <div class="detail-info"><span class="brand"><%=instrumento.marca ? instrumento.marca.nome : ''%></span>
                    <h1><%=instrumento.nome%></h1>
                    <p class="description">Instrumento indicado para o nível <%=instrumento.nivel%><% if(instrumento.categoria){ %>, da categoria <%=instrumento.categoria.nome%><% } %>.</p>
                    <% if(instrumento.fornecedor){ %><p class="availability">● Fornecido por <%=instrumento.fornecedor.nome%></p><% } %>
                    <div class="detail-price"><strong>R$ <%=instrumento.preco%></strong></div>
                    <div class="buy-row">
                        <div class="quantity"><span>−</span><strong>1</strong><span>+</span></div><a class="btn primary"
                            href="/site/carrinho">Adicionar ao carrinho</a>
                    </div>
                    <div class="shipping"><strong>Calcule o frete e prazo</strong>
                        <p><input placeholder="00000-000"> <button class="btn secondary" type="button">Calcular</button></p>
                    </div>
                </div>
            </section>
            <section class="spec-grid">
                <p><span>Marca</span><strong><%=instrumento.marca ? instrumento.marca.nome : '-'%></strong></p>
                <p><span>Categoria</span><strong><%=instrumento.categoria ? instrumento.categoria.nome : '-'%></strong></p>
                <p><span>Nível</span><strong><%=instrumento.nivel%></strong></p>
                <p><span>Fornecedor</span><strong><%=instrumento.fornecedor ? instrumento.fornecedor.nome : '-'%></strong></p>
            </section>
        </main>
        <%-include('rodape.ejs')%>
