<%-include('cabecalho.ejs')%>
        <main class="page container"><span class="eyebrow">Último passo</span>
            <h1 class="page-title">Finalize seu pedido</h1>
            <div class="checkout-layout">
                <div class="checkout-form">
                    <section class="form-card">
                        <h2>1. Dados de entrega</h2>
                        <div class="form-grid"><label class="wide">Nome completo<input
                                    placeholder="Seu nome"></label><label class="wide">Endereço<input
                                    placeholder="Rua e número"></label><label>CEP<input
                                    placeholder="00000-000"></label><label>Cidade<input
                                    placeholder="Sua cidade"></label></div>
                    </section>
                    <section class="form-card">
                        <h2>2. Forma de pagamento</h2>
                        <div class="payment-options"><label><input type="radio" checked name="pagamento"> Cartão de
                                crédito</label><label><input type="radio" name="pagamento"> Pix</label></div>
                        <div class="form-grid"><label class="wide">Número do cartão<input
                                    placeholder="0000 0000 0000 0000"></label><label>Validade<input
                                    placeholder="MM/AA"></label><label>CVV<input placeholder="123"></label><label
                                class="wide">Nome impresso no cartão<input placeholder="Como está no cartão"></label>
                        </div>
                    </section>
                </div>
                <aside class="order-summary">
                    <h2>Resumo do pedido</h2>
                    <p><span>Subtotal</span><strong>R$ 789,90</strong></p>
                    <p><span>Frete</span><strong class="free">Grátis</strong></p>
                    <div class="summary-total"><span>Total</span><strong>R$ 789,90</strong></div><a class="btn primary"
                        href="/site/checkout">Finalizar pagamento</a>
                </aside>
            </div>
        </main>
<%-include('rodape.ejs')%>