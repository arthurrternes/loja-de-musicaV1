<%-include('cabecalho.ejs')%>
        <main class="page container">
            <div class="breadcrumbs"><a href="/site">Início</a><span>›</span><span>Instrumentos</span></div>
            <form action="/site/catalogo" method="post">
            <input type="hidden" name="q" value="<%=q%>">
            <div class="catalog-heading">
                <div><span class="eyebrow">Nossa seleção</span>
                    <h1><%=titulo%></h1>
                    <p><%=instrumentos.length%> <%=instrumentos.length === 1 ? 'produto encontrado' : 'produtos encontrados'%></p>
                </div>
            </div>
            <div class="catalog-layout">
                <aside class="filters">
                    <h2>☷ Filtros</h2>
                    <fieldset class="filter-group">
                        <legend>Categoria</legend>
                        <label><input type="radio" name="categoria" value="" <%=categoriaSel === '' ? 'checked' : ''%>> Todos</label>
                        <% categorias.forEach(function(categoria){ %>
                        <label><input type="radio" name="categoria" value="<%=categoria.id%>" <%=categoriaSel === categoria.id ? 'checked' : ''%>> <%=categoria.nome%></label>
                        <% }) %>
                    </fieldset>
                    <fieldset class="filter-group">
                        <legend>Nível</legend>
                        <label><input type="radio" name="nivel" value="" <%=nivelSel === '' ? 'checked' : ''%>> Todos</label>
                        <label><input type="radio" name="nivel" value="Iniciante" <%=nivelSel === 'Iniciante' ? 'checked' : ''%>> Iniciante</label>
                        <label><input type="radio" name="nivel" value="Intermediário" <%=nivelSel === 'Intermediário' ? 'checked' : ''%>> Intermediário</label>
                        <label><input type="radio" name="nivel" value="Profissional" <%=nivelSel === 'Profissional' ? 'checked' : ''%>> Profissional</label>
                    </fieldset>
                    <button class="btn primary" type="submit" style="width:100%;margin-top:18px">Aplicar filtros</button>
                    <a class="continue" href="/site/catalogo">Limpar filtros</a>
                </aside>
                <div class="product-grid catalog-products">
                    <% if(instrumentos.length === 0){ %>
                    <p style="grid-column:1/-1">Nenhum instrumento encontrado com esses filtros.</p>
                    <% } %>
                    <% instrumentos.forEach(function(instrumento){ %>
                    <article class="product-card"><a href="/site/produto/<%=instrumento.id%>">
                            <div class="product-image"><% if(instrumento.foto){ %><img src="<%=instrumento.foto%>" alt="<%=instrumento.nome%>"><% } %></div>
                        </a>
                        <div class="product-info"><span class="brand"><%=instrumento.marca ? instrumento.marca.nome : ''%> · <%=instrumento.nivel%></span>
                            <h3><a href="/site/produto/<%=instrumento.id%>"><%=instrumento.nome%></a></h3>
                            <div class="price"><strong>R$ <%=instrumento.preco%></strong></div><a class="btn secondary" href="/site/carrinho">Adicionar</a>
                        </div>
                    </article>
                    <% }) %>
                </div>
            </div>
            </form>
        </main>
       <%-include('rodape.ejs')%>
