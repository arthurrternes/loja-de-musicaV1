<%-include('cabecalho.ejs')%>
  <main id="conteudo">
    <section class="hero">
      <div class="hero-inner container">
        <div class="hero-copy"><span class="eyebrow">Sua música começa aqui</span>
          <h1>Encontre o seu som.<br><em>Toque a sua história.</em></h1>
          <p>Instrumentos escolhidos por quem entende de música, para todos os ritmos e momentos.</p>
          <div class="hero-actions"><a class="btn primary" href="/site/catalogo">Explorar instrumentos →</a><a
              class="text-link" href="/site/catalogo">Ver todos os produtos ›</a></div>
        </div>
        <div class="hero-image"><img
            src="https://images.unsplash.com/photo-1511379938547-c1f69419868d?auto=format&fit=crop&w=1300&q=88"
            alt="Músico tocando guitarra em um estúdio"></div>
      </div>
    </section>
    <section class="benefits container" aria-label="Benefícios">
      <div><strong><b>◇</b> Entrega para todo Brasil</strong><small>Rápida e acompanhada</small></div>
      <div><strong><b>▭</b> Até 10x sem juros</strong><small>Nos principais cartões</small></div>
      <div><strong><b>✓</b> Compra 100% segura</strong><small>Seus dados protegidos</small></div>
      <div><strong><b>◉</b> Especialistas em música</strong><small>Ajuda para escolher</small></div>
    </section>
    <section class="section container">
      <div class="section-title">
        <div><span class="eyebrow">Encontre seu instrumento</span>
          <h2>Por onde você quer começar?</h2>
        </div><a class="text-link" href="/site/catalogo">Ver todas as categorias →</a>
      </div>
      <div class="category-grid">
        <% if(cards.length === 0){ %><p>Nenhuma categoria cadastrada ainda.</p><% } %>
        <% cards.forEach(function(card){ %>
        <a class="category-card" style="background:var(--blue-dark)" href="/site/catalogo/<%=card.id%>"><% if(card.foto){ %><img src="<%=card.foto%>" alt=""><% } %>
          <div>
            <h3><%=card.nome%></h3><span>Explorar →</span>
          </div>
        </a>
        <% }) %>
      </div>
    </section>
    <section class="section soft">
      <div class="container">
        <div class="section-title">
          <div><span class="eyebrow">Favoritos dos músicos</span>
            <h2>Instrumentos em destaque</h2>
          </div><a class="text-link" href="/site/catalogo">Ver todos →</a>
        </div>
        <div class="product-grid">
          <% if(destaques.length === 0){ %><p>Nenhum instrumento cadastrado ainda.</p><% } %>
          <% destaques.forEach(function(instrumento){ %>
          <article class="product-card"><a href="/site/produto/<%=instrumento.id%>">
              <div class="product-image"><% if(instrumento.foto){ %><img src="<%=instrumento.foto%>" alt="<%=instrumento.nome%>"><% } %></div>
            </a>
            <div class="product-info"><span class="brand"><%=instrumento.marca ? instrumento.marca.nome : ''%> · <%=instrumento.nivel%></span>
              <h3><a href="/site/produto/<%=instrumento.id%>"><%=instrumento.nome%></a></h3>
              <div class="price"><strong>R$ <%=instrumento.preco%></strong></div><a class="btn secondary" href="/site/carrinho">Adicionar</a>
            </div>
          </article>
          <% }) %>
        </div>
      </div>
    </section>
    <section class="story container"><img
        src="https://images.unsplash.com/photo-1694632157646-3a7292b82b0c?auto=format&fit=crop&w=1000&q=85"
        alt="Interior de loja com instrumentos musicais">
      <div class="story-copy"><span class="eyebrow">Muito além de uma loja</span>
        <h2>Feito por músicos,<br>para músicos.</h2>
        <p>Cada produto é selecionado com cuidado e cada atendimento começa com uma boa conversa.</p><a
          class="btn secondary" href="/site/catalogo">Conheça nossa seleção →</a>
      </div>
    </section>
  </main>
  <%-include('rodape.ejs')%>